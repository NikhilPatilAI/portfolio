# Copy to .env.local for local runs. On Vercel, add these under Project Settings > Environment Variables.
# Never commit real values.

# Canonical site address for metadata, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://nikhilpatilai.vercel.app

# Ask Nikhil (the AI answers in the command palette), through OpenRouter. Without a key the palette says it isn't
# switched on yet. Create one at https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
# Optional. The first model to try; defaults to nvidia/nemotron-3-super-120b-a12b:free, with two more free
# Nemotron models behind it.
ASK_MODEL=
# Optional. Questions the whole site will answer in a day before resting. Defaults to 300.
ASK_DAILY_CAP=

# Optional. Upstash Redis from the Vercel Marketplace sets these, which shares rate limits across servers and keeps
# the anonymous question log (list "ask:log"). Without them, limits are per server and questions go to the runtime log.
KV_REST_API_URL=
KV_REST_API_TOKEN=
